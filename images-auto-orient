#!/bin/sh
set -eu

case "$0" in
  /*) repo_dir="$(dirname "$0")" ;;
  */*) repo_dir="$(cd "$(dirname "$0")" && pwd)" ;;
  *) repo_dir="$(dirname "$(command -v "$0")")" ;;
esac
. "$repo_dir/lib/img-docker"

usage() {
  cat <<EOF
Usage: $(basename "$0") <directory>

Apply EXIF orientation to every .jpg in <directory>, rotating pixels so the
image is visually upright and clearing the orientation tag. Modifies files
in place.

Options:
  -h, --help        Show this help and exit
EOF
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  '') usage >&2; exit 1 ;;
esac

dir="${1%/}"
test -d "$dir" || { echo "Error: '$dir' is not a directory" >&2; exit 2; }

mount="$(img_mount_for "$dir")"

for f in "$dir"/*.jpg; do
  if test -f "$f"; then
    img_run --mount "$mount" mogrify -auto-orient "$f"
    echo "auto-oriented: $f"
  fi
done
