#!/bin/sh
set -eu

case "$0" in
  /*) repo_dir="$(dirname "$0")" ;;
  */*) repo_dir="$(cd "$(dirname "$0")" && pwd)" ;;
  *) repo_dir="$(dirname "$(command -v "$0")")" ;;
esac
. "$repo_dir/lib/img-docker"

usage() {
  cat <<EOF
Usage: $(basename "$0") [-r] PATH...

Normalize .jpe and .jpeg files to .jpg. Each PATH can be a file or a
directory. With -r, directories are walked recursively. Source files are
left in place; a sibling .jpg is created.

Non-matching files (including existing .jpg) are silently skipped (safe to
call against a mixed directory).

Options:
  -r                Recurse into subdirectories
  -h, --help        Show this help and exit

Environment:
  IMG_JPG_QUALITY   JPEG quality (default 85)
EOF
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
esac

recursive=0
while getopts "rh" opt; do
  case "$opt" in
    r) recursive=1 ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

test -n "${1:-}" || { usage >&2; exit 1; }

quality="${IMG_JPG_QUALITY:-85}"

fn_convert() {
  f="$1"
  mount="$(img_mount_for "$f")"
  img_run --mount "$mount" mogrify -auto-orient -format jpg -quality "$quality" "$f"
  echo "converted: $f -> ${f%.*}.jpg"
}

fn_process() {
  p="$1"
  if test -d "$p"; then
    for f in "${p%/}"/*; do
      if test -d "$f" && test "$recursive" -eq 1; then
        fn_process "$f"
      elif test -f "$f"; then
        case "$f" in
          *.jpe | *.JPE | *.jpeg | *.JPEG) fn_convert "$f" ;;
        esac
      fi
    done
  elif test -f "$p"; then
    case "$p" in
      *.jpe | *.JPE | *.jpeg | *.JPEG) fn_convert "$p" ;;
    esac
  fi
}

for arg in "$@"; do
  fn_process "$arg"
done
