#!/bin/sh
set -eu

. "$(dirname "$0")/lib/img-docker"

usage() {
  echo "Usage: $(basename "$0") [-d] [-r] <directory>"
  exit 1
}

dry_run=0
recursive=0

while getopts "dr" opt; do
  case "$opt" in
    d) dry_run=1 ;;
    r) recursive=1 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

test -n "${1:-}" || usage
dir="${1%/}"
test -d "$dir" || { echo "Error: '$dir' is not a directory"; exit 2; }

fn_process() {
  b_dir="$1"
  for f in "$b_dir"/*; do
    if test -d "$f" && test "$recursive" -eq 1; then
      fn_process "$f"
    elif test -f "$f"; then
      case "$f" in
        *.heic | *.HEIC | *.png | *.PNG | *.jpe | *.JPE | *.jpeg | *.JPEG)
          if test "$dry_run" -eq 1; then
            echo "[dry run] mogrify -auto-orient -format jpg $f"
          else
            img_run mogrify -auto-orient -format jpg "$f"
            echo "converted: $f -> ${f%.*}.jpg"
          fi
          ;;
        *.jpg | *.JPG)
          echo "skipping (already jpg): $f"
          ;;
        *)
          echo "unsupported: $f"
          ;;
      esac
    fi
  done
}

fn_process "$dir"
