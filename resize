#!/bin/sh
set -eu

case "$0" in
  /*) repo_dir="$(dirname "$0")" ;;
  */*) repo_dir="$(cd "$(dirname "$0")" && pwd)" ;;
  *) repo_dir="$(dirname "$(command -v "$0")")" ;;
esac
. "$repo_dir/lib/img-docker"

max_px="${1:-1200}"
quality="${IMG_JPG_QUALITY:-85}"
shift

for f in "$@"; do
  out="${f%.*}-resized.${f##*.}"
  img_run magick "$f" -auto-orient -resize "${max_px}x${max_px}>'" -quality "$quality" "$out"
  echo "$f -> $out"
done
