#!/bin/sh
set -eu

case "$0" in
  /*) repo_dir="$(dirname "$0")" ;;
  */*) repo_dir="$(cd "$(dirname "$0")" && pwd)" ;;
  *) repo_dir="$(dirname "$(command -v "$0")")" ;;
esac
. "$repo_dir/lib/img-docker"

usage() {
  cat <<EOF
Usage: $(basename "$0") <directory>

Strip embedded metadata from .jpg and .png files in <directory>. Modifies
files in place.

JPG: clears Orientation only (pairs with images-auto-orient).
PNG: strips all metadata via 'exiftool -all=', including tEXt/iTXt chunks
and XMP. Useful for scrubbing AI-generation tags from PNG exports.

Options:
  -h, --help        Show this help and exit
EOF
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  '') usage >&2; exit 1 ;;
esac

dir="${1%/}"
test -d "$dir" || { echo "Error: '$dir' is not a directory" >&2; exit 2; }

mount="$(img_mount_for "$dir")"

for f in "$dir"/*.jpg; do
  if test -f "$f"; then
    img_run --mount "$mount" exiftool -Orientation= -n -overwrite_original "$f"
    echo "stripped metadata: $f"
  fi
done

for f in "$dir"/*.png; do
  if test -f "$f"; then
    img_run --mount "$mount" exiftool -all= -overwrite_original "$f"
    echo "stripped metadata: $f"
  fi
done
