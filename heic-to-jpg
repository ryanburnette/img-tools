#!/bin/sh
set -eu

case "$0" in
  /*) repo_dir="$(dirname "$0")" ;;
  */*) repo_dir="$(cd "$(dirname "$0")" && pwd)" ;;
  *) repo_dir="$(dirname "$(command -v "$0")")" ;;
esac
. "$repo_dir/lib/img-docker"

quality="${IMG_JPG_QUALITY:-85}"

for f in "$@"; do
  out="${f%.*}.jpg"
  img_run magick "$f" -auto-orient -quality "$quality" "$out"
  echo "$f -> $out"
done
